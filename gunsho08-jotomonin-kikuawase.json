 "poems": [
  {
   "seq": "1",
   "text": "長きよのためしにうふる八重の花行すゑとをく君のみそ見む",
   "kana": "",
   "speaker": "",
   "page": 614,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "紫の匂ひことなる八重の花はつしもよりやわきてをくらむ",
   "kana": "",
   "speaker": "",
   "page": 614,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "めもかれすみつゝくらさんしら菊の花より後の花しなけれは",
   "kana": "",
   "speaker": "",
   "page": 614,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "うすくこくうつろふ色はをく霜にみなしら菊とみえわたる哉",
   "kana": "",
   "speaker": "",
   "page": 614,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "ひころへてうつろひまさる菊の花幾夜の霜をふるにか有らん",
   "kana": "",
   "speaker": "",
   "page": 614,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "もろ人の心を花になす物はうつろふきくのさかりなりけり",
   "kana": "",
   "speaker": "",
   "page": 614,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "さく花のたくひ有とそ思ひける色〓〓にほふきくのまかきを",
   "kana": "",
   "speaker": "",
   "page": 614,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "千世ふへき君かまかきの菊みてそ花の中にも久しかりける",
   "kana": "",
   "speaker": "",
   "page": 614,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "みるまゝに色のまさるはきくの花ちよまてさけと霜そ置らし",
   "kana": "",
   "speaker": "",
   "page": 614,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "朝霜におきつゝみれは菊のはなよのま〓〓ににほひこそませ",
   "kana": "",
   "speaker": "",
   "page": 614,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "月影のてりそふ菊はうつろへる上にもしものをくかとそ見る",
   "kana": "",
   "speaker": "",
   "page": 614,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "あかすみるかひも有かななかきよのためしにさける白菊の花",
   "kana": "",
   "speaker": "",
   "page": 614,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "たちならふ色なき物はむらさきにうつろふ菊の花にそ有ける",
   "kana": "",
   "speaker": "",
   "page": 614,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "月影に霜をきまかふしら菊のかをたつねすはいかておらまし",
   "kana": "",
   "speaker": "",
   "page": 614,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "月かけにむらさきふかき菊の上はいく霜をきてそめし匂ひそ",
   "kana": "",
   "speaker": "",
   "page": 615,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "菊の花うつろふ色をみてのみそ思ふことなき身とはなりぬる",
   "kana": "",
   "speaker": "",
   "page": 615,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "よな〓〓の霜に色ます菊のはなけふのためとや思ひをきけん",
   "kana": "",
   "speaker": "",
   "page": 615,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "月かけの風に亂るゝむらさきはなひく方にそ色をかへける",
   "kana": "",
   "speaker": "",
   "page": 615,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "こむらさきやしほ染たる菊の花うつろふ色とたれかみるらん",
   "kana": "",
   "speaker": "",
   "page": 615,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "にほふ色のこなたは深き菊のはなまさるかたにや霜も置らん",
   "kana": "",
   "speaker": "",
   "page": 615,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
