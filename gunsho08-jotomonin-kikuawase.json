 "blocks": [
  {
   "id": "gunsho08-jotomonin-kikuawase-0001",
   "pid": "1879502",
   "pages": [
    614
   ],
   "text": "上東門院菊合和歌〔舊本行書躰〕一番左月影のてりそふ菊はうつろへる上にもしものをくかとそ見る右あかすみるかひも有かななかきよのためしにさける白菊の花七番左伊勢大輔長きよのためしにうふる八重の花行すゑとをく君のみそ見む右伊興中納言紫の匂ひことなる八重の花はつしもよりやわきてをくらむ二番左みの弁たちならふ色なき物はむらさきにうつろふ菊の花にそ有ける右月影に霜をきまかふしら菊のかをたつねすはいかておらまし",
   "poems": [
    "1",
    "2",
    "3",
    "4",
    "5",
    "6"
   ],
   "lb": []
  },
  {
   "id": "gunsho08-jotomonin-kikuawase-0002",
   "pid": "1879502",
   "pages": [
    615
   ],
   "text": "朱雀院女郞花合八番左大輔月かけにむらさきふかき菊の上はいく霜をきてそめし匂ひそ右弁乳母菊の花うつろふ色をみてのみそ思ふことなき身とはなりぬる九番左小弁よな〓〓の霜に色ます菊のはなけふのためとや思ひをきけん右月かけの風に亂るゝむらさきはなひく方にそ色をかへける十番左こむらさきやしほ染たる菊の花うつろふ色とたれかみるらん右にほふ色のこなたは深き菊のはなまさるかたにや霜も置らん右以木村孔恭藏本書寫畢",
   "poems": [
    "7",
    "8",
    "9",
    "10",
    "11",
    "12"
   ],
   "lb": []
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "月影のてりそふ菊はうつろへる上にもしものをくかとそ見る",
   "kana": "",
   "speaker": "",
   "page": 614,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "あかすみるかひも有かななかきよのためしにさける白菊の花",
   "kana": "",
   "speaker": "",
   "page": 614,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "長きよのためしにうふる八重の花行すゑとをく君のみそ見む",
   "kana": "",
   "speaker": "",
   "page": 614,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "紫の匂ひことなる八重の花はつしもよりやわきてをくらむ",
   "kana": "",
   "speaker": "",
   "page": 614,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "たちならふ色なき物はむらさきにうつろふ菊の花にそ有ける",
   "kana": "",
   "speaker": "",
   "page": 614,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "月影に霜をきまかふしら菊のかをたつねすはいかておらまし",
   "kana": "",
   "speaker": "",
   "page": 614,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "月かけにむらさきふかき菊の上はいく霜をきてそめし匂ひそ",
   "kana": "",
   "speaker": "",
   "page": 615,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "菊の花うつろふ色をみてのみそ思ふことなき身とはなりぬる",
   "kana": "",
   "speaker": "",
   "page": 615,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "よな〓〓の霜に色ます菊のはなけふのためとや思ひをきけん",
   "kana": "",
   "speaker": "",
   "page": 615,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "月かけの風に亂るゝむらさきはなひく方にそ色をかへける",
   "kana": "",
   "speaker": "",
   "page": 615,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "こむらさきやしほ染たる菊の花うつろふ色とたれかみるらん",
   "kana": "",
   "speaker": "",
   "page": 615,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "にほふ色のこなたは深き菊のはなまさるかたにや霜も置らん",
   "kana": "",
   "speaker": "",
   "page": 615,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
